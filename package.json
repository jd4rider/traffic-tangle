{
  "name": "traffic-tangle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Traffic Tangle \u2014 a 2.5D route-drawing traffic puzzle for Little Joy Arcade.",
  "author": "jd4rider",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
